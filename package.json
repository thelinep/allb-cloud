{
  "name": "allb-cloud",
  "private": true,
  "scripts": {
    "setup": "npm ci --prefix apps/maataa-ui-route-source",
    "dev": "npm --prefix apps/maataa-ui-route-source run dev",
    "build": "npm --prefix apps/maataa-ui-route-source run build",
    "start": "npm --prefix apps/maataa-ui-route-source run start",
    "typecheck": "npm --prefix apps/maataa-ui-route-source run typecheck",
    "test:config": "node --experimental-strip-types packages/design-config/tests/config.test.mjs",
    "test:routes": "npm --prefix apps/maataa-ui-route-source run validate:routes",
    "test:integration": "npm --prefix apps/maataa-ui-route-source run test:integration",
    "test:design-dom": "npm --prefix apps/maataa-ui-route-source run test:design-dom",
    "test:browser": "npm --prefix apps/maataa-ui-route-source run test:browser --",
    "test:db": "npm --prefix apps/maataa-ui-route-source run test:db",
    "test:auth-core": "npm --prefix apps/maataa-ui-route-source run test:auth-core",
    "test:authorization": "node apps/maataa-ui-route-source/tests/authorization.test.mjs",
    "test:publishing": "node tests/design-publishing.test.mjs",
    "test:nevo": "node --test tests/nevo-workflow.test.mjs",
    "preflight:cloudflare": "node scripts/cloudflare-preflight.mjs"
  },
  "type": "module"
}
