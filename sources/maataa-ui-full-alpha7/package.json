  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/finalize-esm.mjs && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "tsc -p tsconfig.contracts.json && node --experimental-strip-types --no-warnings --test tests/contracts/*.contract-spec.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir .certification/storybook",
    "format": "prettier --write src tests stories docs manifests README.md",
    "format:check": "prettier --check src tests stories docs manifests README.md",
    "api:manifest": "node scripts/api-manifest.mjs",
    "registry:coverage": "node scripts/api-manifest.mjs --check && node scripts/audit-component-registry-coverage.mjs",
    "compare:consumers": "node scripts/compare-maataa-ui-active-consumers.mjs",
    "prepack": "pnpm build && pnpm api:manifest && pnpm api:atomic && pnpm redux:manifest && pnpm type:manifest && pnpm depth:manifest && pnpm device:manifest && pnpm validate:devices && pnpm demo:manifest && pnpm validate:demo && pnpm surface:manifest && pnpm validate:surface && pnpm identity:manifest && pnpm validate:depth && pnpm beta:manifest",
    "api:atomic": "node scripts/atomic-manifest.mjs",
    "validate:ai": "node scripts/validate-ai-catalog.mjs",
    "device:manifest": "node scripts/device-manifest.mjs",
    "validate:devices": "node scripts/validate-device-catalog.mjs",
    "demo:manifest": "node scripts/demo-manifest.mjs",
    "validate:demo": "node scripts/validate-demo.mjs",
    "demo": "vite --config examples/redux-demo/vite.config.mjs",
    "tlp:dev": "vite --config apps/tlp-film/vite.config.mjs",
    "tlp:build": "vite build --config apps/tlp-film/vite.config.mjs",
    "tlp:typecheck": "tsc --noEmit -p apps/tlp-film/tsconfig.json",
    "tlps:dev": "vite --config apps/tlps/vite.config.mjs",
    "tlps:build": "vite build --config apps/tlps/vite.config.mjs",
    "tlps:typecheck": "tsc --noEmit -p apps/tlps/tsconfig.json",
    "products:build": "pnpm tlp:build && pnpm tlps:build",
    "products:typecheck": "pnpm tlp:typecheck && pnpm tlps:typecheck",
    "products:e2e": "playwright test --config playwright.products.config.ts",
    "support-center": "vite --config examples/support-center/vite.config.mjs",
    "support-center:catalog": "pnpm workspace:slices:check && node scripts/generate-support-center-package-index.mjs",
    "support-center:build": "pnpm support-center:catalog && vite build --config examples/support-center/vite.config.mjs",
    "support-center:typecheck": "tsc --noEmit -p examples/support-center/tsconfig.json",
    "support-center:screenshots": "pnpm support-center:catalog && playwright test --config playwright.gallery.config.ts && playwright test --config playwright.support-gallery.config.ts",
    "maataa:desktop:build": "pnpm demo:build && pnpm support-center:build && pnpm tlp:build && pnpm tlps:build",
    "maataa:browser:dev": "cargo run --manifest-path apps/maataa-browser/src-tauri/Cargo.toml --locked",
    "maataa:browser:build": "cargo build --manifest-path apps/maataa-browser/src-tauri/Cargo.toml --locked --release",
    "maataa:desktop:dev": "pnpm maataa:desktop:build && cargo build --manifest-path apps/maataa-browser/src-tauri/Cargo.toml --locked && electron examples/support-center/electron",
    "maataa:desktop:check": "pnpm maataa:desktop:build && playwright test --config playwright.desktop.config.ts",
    "maataa:desktop:pack": "pnpm support-center:screenshots && pnpm maataa:desktop:build && pnpm maataa:browser:build && electron-builder --mac --arm64 --config examples/support-center/electron-builder.yml",
    "maataa:tauri:products": "pnpm demo:build && pnpm products:build && pnpm support-center:build && node scripts/build-tauri-desktop-products.mjs",
    "maataa:tauri:build": "pnpm maataa:tauri:products && cd apps/maataa-desktop-tauri/src-tauri && cargo tauri build --bundles app --no-sign",
    "maataa:tauri:check": "pnpm products:typecheck && cargo fmt --check --manifest-path apps/maataa-desktop-tauri/src-tauri/Cargo.toml && cargo test --manifest-path apps/maataa-desktop-tauri/src-tauri/Cargo.toml --offline && playwright test --config playwright.desktop-tauri-trial.config.ts",
    "support-center:desktop:dev": "pnpm maataa:desktop:dev",
    "support-center:desktop:pack": "pnpm maataa:desktop:pack",
    "support-center:check": "pnpm support-center:typecheck && pnpm support-center:screenshots && pnpm support-center:build && playwright test --config playwright.support.config.ts",
    "brahmini:runtime": "node examples/redux-demo/brahmini-runtime.mjs",
    "brahmini:dev": "node scripts/start-brahmini-demo.mjs",
    "brahmini:preview": "node scripts/start-brahmini-demo.mjs --preview",
    "demo:build": "node scripts/generate-preview-loaders.mjs && vite build --config examples/redux-demo/vite.config.mjs",
    "demo:videos": "pnpm demo:build && node scripts/record-demo-videos.mjs",
    "demo:preview": "vite preview --config examples/redux-demo/vite.config.mjs",
    "surface:manifest": "node scripts/public-surface-manifest.mjs",
    "validate:surface": "node scripts/validate-public-surface.mjs",
    "identity:manifest": "node scripts/identity-manifest.mjs",
    "stories:generate": "node scripts/generate-component-stories.mjs",
    "validate:depth": "node scripts/validate-depth.mjs",
    "certify": "pnpm typecheck && pnpm test && pnpm registry:coverage && pnpm stories:generate && pnpm storybook:build && pnpm demo:build && pnpm validate:depth",
    "redux:manifest": "node scripts/redux-manifest.mjs",
    "workspace:slices": "node scripts/generate-workspace-data-slices.mjs",
    "workspace:slices:check": "node scripts/generate-workspace-data-slices.mjs --check",
    "type:manifest": "node scripts/type-manifest.mjs",
    "depth:manifest": "node scripts/depth-manifest.mjs",
    "storybook:check": "node scripts/check-storybook-stack.mjs",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "package:consumer": "node scripts/certify-consumer.mjs",
    "consumer:next:preview": "node fixtures/consumer-next/serve-export.mjs",
    "browser:install": "playwright install chromium firefox webkit",
    "browser:test": "pnpm demo:build && playwright test",
    "browser:a11y": "pnpm demo:build && playwright test tests/e2e/accessibility.spec.ts",
    "beta:manifest": "node scripts/beta-prep-manifest.mjs",
    "beta:validate": "node scripts/validate-beta-prep.mjs",
    "certify:beta:no-browser": "pnpm certify && pnpm package:consumer && pnpm bundle:check && pnpm beta:validate",
    "certify:beta": "pnpm certify:enterprise",
    "security:baseline": "node scripts/security-baseline.mjs",
    "performance:check": "node scripts/check-composition-performance.mjs",
    "docs:generate": "node scripts/generate-canonical-docs.mjs",
    "docs:check": "node scripts/generate-canonical-docs.mjs --check",
    "certify:enterprise": "node scripts/certify-enterprise.mjs",
